# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-key-skillswap-2026

# Database Configuration
# Local SQLite default (used if DATABASE_URL is not set or empty):
DATABASE_URL=sqlite:///skillswap.db
# For PostgreSQL in production, use:
# DATABASE_URL=postgresql://skillswap_user:securepassword@localhost:5432/skillswap_db

# Security & Sessions
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
WTF_CSRF_ENABLED=True

# Socket Configuration
SOCKETIO_ASYNC_MODE=threading
RAW_SOCKET_PORT=9099
RAW_SOCKET_HOST=127.0.0.1

# Initial Administrator Credentials (used only during first-time database seed)
ADMIN_EMAIL=admin@skillswap.edu
ADMIN_PASSWORD=AdminSecurePass2026!
ADMIN_NAME=System Administrator
